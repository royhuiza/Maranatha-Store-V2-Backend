# Copiar a .env local (ignorado por Git y por Docker). No colocar claves en Angular.
# Todos los valores tienen defaults en docker-compose.yml, asi que el stack
# tambien arranca sin este archivo.

# Clave de PostgreSQL usada por todos los microservicios.
POSTGRES_PASSWORD=admin123

# Clave de firma JWT (debe ser larga y secreta en produccion).
JWT_SECRET=MaranathaStoreClaveSuperSeguraJWT2026Maranatha

# Clave de la API de Evolution (WhatsApp) y nombre de la instancia.
EVOLUTION_API_KEY=maranatha_secret_key_2026
EVOLUTION_API_INSTANCE=maranatha-store

# Clave de la API de Google AI Studio (Gemini). Es la que usa el nodo
# "Google Gemini Chat Model" del workflow del chatbot.
# Sin ella el chat responde el mensaje de fallback en vez de la respuesta
# del modelo. Tambien se puede pegar desde la UI de n8n (http://localhost:5678).
GEMINI_API_KEY=

# Clave de Decolecta (proveedor de consulta de DNI y RUC). Sin ella la web
# responde 503 al buscar documentos de clientes.
DECOLECTA_API_KEY=

# Correo real: completar localmente segun las indicaciones del proveedor SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
FRONTEND_URL=http://localhost:4200
