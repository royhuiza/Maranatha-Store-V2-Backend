# Copiar a .env local (ignorado por Git y por Docker). No colocar claves en Angular.
DECOLECTA_API_KEY=
# Solo claves de prueba; el adaptador rechaza claves de produccion.
CULQI_TEST_SECRET_KEY=

# Correo real: completar localmente segun las indicaciones del proveedor SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
FRONTEND_URL=http://localhost:4200
